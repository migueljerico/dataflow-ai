# DataFlow AI — Variables de entorno
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=8000
MAX_FILE_SIZE_BYTES=10485760
MAX_URL_FILE_SIZE_BYTES=20971520
# Cache de inferencia distribuida (opcional): backend L2 Redis / Cloud Memorystore
INFERENCE_CACHE_BACKEND=memory
# Ejemplo Memorystore con TLS: rediss://10.0.0.3:6379
REDIS_URL=
